{
    "schemaVersion": 1,
    "id": "oie-log-viewer",
    "name": "OIE 日志查看器",
    "description": "在管理界面中查看、分页浏览、搜索和下载引擎的 mirth.log 及其轮转归档文件，无需访问引擎主机的操作系统。同时支持 Swing 和 Web 管理界面。",
    "type": "plugin",
    "ui": [
        "web",
        "swing"
    ],
    "version": "1.0.0",
    "minEngineVersion": "4.6.0",
    "maxEngineVersion": "4.6.0",
    "filename": "oie-log-viewer-{version}.zip",
    "restartRequired": true,
    "homepage": "https://github.com/diridium-com/oie-log-viewer",
    "documentation": "https://github.com/diridium-com/oie-log-viewer#readme",
    "storeDocs": "docs/store.md",
    "license": "MPL-2.0",
    "authors": [
        "Diridium Technologies Inc."
    ],
    "keywords": [
        "logs",
        "mirth.log",
        "server-log",
        "troubleshooting",
        "administration"
    ],
    "deprecated": false
}